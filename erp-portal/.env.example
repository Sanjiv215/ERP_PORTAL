# ==============================================================================
# ERP Portal Environment Variables Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the required values before running the app.
# NEVER commit the real .env file with production credentials to source control.
# ==============================================================================

# ── Application Environment ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── PostgreSQL Database Configuration ─────────────────────────────────────────
# For Managed PostgreSQL or Cloud DB, provide DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/erp_portal?sslmode=require
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_DATABASE=erp_portal
PG_SSL=false

# ── JWT Authentication Secrets ───────────────────────────────────────────────
# Generate high-entropy 256-bit keys: `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_with_a_long_random_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_jwt_refresh_secret_min_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# ── AES-256-GCM Field-Level Encryption ───────────────────────────────────────
# Must be a 32-byte (256-bit) key encoded in Base64: `openssl rand -base64 32`
EMPLOYEE_FIELD_ENCRYPTION_KEY_BASE64=replace_with_32_random_bytes_base64_key==

# ── Redis (Session Cache / Rate Limiting) ────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

